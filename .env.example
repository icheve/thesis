# Copy this file to .env and fill in values for local dev.

# ─── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_INPUT_TOPIC=payments.raw
KAFKA_OUTPUT_TOPIC=payments.processed
KAFKA_DLQ_TOPIC=payments.dlq
KAFKA_LATE_TOPIC=payments.late
KAFKA_CONSUMER_GROUP=payment-pipeline

# ─── ClickHouse ───────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=payments
CLICKHOUSE_USER=pipeline_writer
CLICKHOUSE_PASSWORD=pipeline_secret   # dev only — change in production

# ─── Schema Registry ──────────────────────────────────────────
SCHEMA_REGISTRY_URL=http://localhost:8081

# ─── Flink ────────────────────────────────────────────────────
FLINK_PARALLELISM=8
FLINK_CHECKPOINT_INTERVAL_MS=30000
FLINK_WATERMARK_DELAY_MIN=10

# ─── Monitoring ───────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
# Grafana admin password (dev only)
GF_SECURITY_ADMIN_PASSWORD=admin_secret
